  "ui_config": {
    "display_name": "KnowledgeJump",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "KnowledgeJump"
      }
    ]
  }
}
